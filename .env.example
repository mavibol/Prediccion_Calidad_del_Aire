# Copie este archivo como .env (cp .env.example .env) y complete los valores.
# Generar la clave:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_DEBUG=0
# IP pública del VPS y, si hay, el dominio. Separados por coma, sin espacios ni http://
DJANGO_ALLOWED_HOSTS=IP_DEL_VPS
# Los mismos valores con esquema. Sin dominio: http://IP_DEL_VPS
DJANGO_CSRF_TRUSTED_ORIGINS=http://IP_DEL_VPS
# 1 solo cuando NGINX_MODO=https
DJANGO_HTTPS=0

# --- Modelo ---
AIRE_METEO_EN_LINEA=1
AIRE_IMPUTACION=iterativa

# --- Nginx ---
# http mientras no haya dominio; https después de obtener el certificado
NGINX_MODO=http
# Dominio sin www (solo para https). Con NGINX_MODO=http puede quedar vacío
DOMINIO=
